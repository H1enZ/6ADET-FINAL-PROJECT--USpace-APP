# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real keys.
#
# Run locally with:
#   flutter run -d chrome --dart-define-from-file=.env
#
# The deploy workflow reads the same two required names from repository
# secrets (Settings > Secrets and variables > Actions).

# REQUIRED. Supabase dashboard > Project Settings > API (or "API Keys").
# Both are safe to ship in the app: the row-level security policies in
# supabase/schema.sql protect the data, not the secrecy of these values.
SUPABASE_URL=https:https://ijwehihusjfesjzvvuqo.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_akaAOnl7Xu50C3kYyx264Q_yTVgsyDu

# OPTIONAL, development only. Remove the leading # to use them.
#
# Run Therabot against a function on your own machine instead of the deployed
# one. Only used in debug builds, and only for localhost, 127.0.0.1 or 10.0.2.2.
# THERABOT_FUNCTIONS_URL=http://localhost:8000
#
# Show the app inside a phone frame on a desktop browser. Never used in the
# deployed build.
# ENABLE_DEVICE_PREVIEW=true

# NEVER put these in the app or this repo:
# - SUPABASE_SECRET_KEY / the service_role key bypasses every security policy.
# - GROQ_API_KEY (the Therabot AI key) is a server-side secret. Set it in
#   Supabase (Edge Function secrets), never in this file.
