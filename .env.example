# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real keys.
#
# Run locally with:
#   flutter run -d chrome --dart-define-from-file=.env
#
# The deploy workflow reads the same two names from repository secrets
# (Settings > Secrets and variables > Actions).

# Supabase dashboard > Project Settings > API (or "API Keys").
# Both are safe to ship in the app: the row-level security policies in
# supabase/schema.sql protect the data, not the secrecy of these values.
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_PUBLISHABLE_KEY=put_your_publishable_key_here

# NEVER put these in the app or this repo:
# SUPABASE_SECRET_KEY (service_role) bypasses every security policy.
